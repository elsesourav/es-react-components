{
  "name": "@elsesourav/react-ui",
  "version": "1.1.0",
  "description": "Production-grade React 19 UI component library with tactile specular depth, spring physics, and dynamic theme tokens.",
  "type": "module",
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/index.cjs"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://components.elsesourav.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elsesourav/es-react-components.git"
  },
  "keywords": [
    "react",
    "react19",
    "ui",
    "component-library",
    "tailwind",
    "motion",
    "tactile-shadows",
    "design-tokens"
  ],
  "author": "Sourav (@elsesourav)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "sync:sources": "node scripts/sync_component_sources.cjs",
    "prebuild": "node scripts/sync_component_sources.cjs",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:all": "pnpm run build && pnpm run build:lib",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release:patch": "npm version patch && pnpm run build:lib && npm publish --access public",
    "release:minor": "npm version minor && pnpm run build:lib && npm publish --access public",
    "release:major": "npm version major && pnpm run build:lib && npm publish --access public",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@types/gsap": "^3.0.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.475.0",
    "motion": "^14.11.1",
    "react": "^19.0.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.3"
  }
}
